# Copy to landing/.env on the server and adjust. Never commit landing/.env.

# Public domain served by the host reverse proxy (apex; www redirects to it).
LANDING_DOMAIN=asitechsolution.cloud
# Port on 127.0.0.1 where the container listens. Must match proxy_pass in the vhost.
LANDING_PORT=8088
# E-mail used by Let's Encrypt for expiry notices. Optional when the host already has
# a Let's Encrypt account (certbot then reuses it).
LETSENCRYPT_EMAIL=
