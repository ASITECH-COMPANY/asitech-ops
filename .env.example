# ASITECH OPS — environment for the local development stack (docker-compose.yml).
# Copy to .env and adjust. Never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public URL of the dashboard, used in invitation links.
ASITECH_PUBLIC_URL=http://localhost:5173
# Who may create organizations: "staff" (platform admins) or "any" (every signed-in user).
ORGANIZATION_CREATION=staff
LOG_LEVEL=INFO

# --- PostgreSQL ---------------------------------------------------------------------------
POSTGRES_DB=asitech_ops
POSTGRES_USER=asitech_ops
POSTGRES_PASSWORD=change-me
# Used when running Django on the host (outside Docker). Inside Compose, the
# service name "postgres" is used instead.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

# --- Redis ----------------------------------------------------------------------------------
REDIS_URL=redis://localhost:16379/0

# --- E-mail (console backend in development: e-mails are printed in the logs) -------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL="ASITECH OPS <no-reply@localhost>"

# --- Host ports for the dev stack (bound to 127.0.0.1) ------------------------------------
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
# Your user id/group id (run `id -u` / `id -g`), so containers write files you own.
HOST_UID=1000
HOST_GID=1000

# --- Agents (Phase 2) -------------------------------------------------------------------------
# URL agents use to reach the Control Plane (defaults to ASITECH_PUBLIC_URL).
# AGENT_CONTROL_PLANE_URL=https://ops.example.com
# AGENT_ENROLLMENT_TTL_MINUTES=60
# AGENT_OFFLINE_AFTER_SECONDS=90
# METRICS_RETENTION_DAYS=7
